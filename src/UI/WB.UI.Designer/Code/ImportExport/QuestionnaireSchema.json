{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.mysurvey.solutions/schemas/questionnaire.schema.json",
  "title": "Questionnaire Document",
  "description": "Survey Solutions questionnaire document",
  "type": "object",
  "additionalProperties": false,
  
  "properties": {
    "CoverPage": { "$ref": "#/definitions/CoverPage" },
    "DefaultTranslation": { "type": "string", "maxLength": 32 },
    "Id": { "$ref": "#/definitions/GUID" },
    "Title": { "type": "string" },
    "Description": { "type": "string" },
    "VariableName": { "$ref": "#/definitions/VariableName" },
    "HideIfDisabled": { "type": "boolean", "default": false },
    "Children": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Group"
      },
      "minItems": 1
    },
    "Macros": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Macro"
      }
    },
    "LookupTables": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LookupTable"
      }
    },
    "Attachments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Attachment"
      }
    },
    "Translations": { "$ref": "#/definitions/Translations" },
    "Categories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Categories"
      }
    },
    "CriticalRules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CriticalRule"
      }
    },
    "Metadata": { "$ref": "#/definitions/QuestionnaireMetaInfo" }
  },

  "required": ["Id", "Title"],

  "definitions": {
    "Answer": {
      "type": "object",
      "properties": {
        "Text": { "type": "string" },
        "Code": { "type": [ "integer", "null" ]},
        "ParentCode": { "type": [ "integer", "null" ] },
        "AttachmentName" : {"type":  ["string", "null"] }
      },
      "additionalProperties": false,
      "required": []
    },
  
    "Answers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Answer"
      }
    },

    "AreaQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["AreaQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },
        
        "GeometryType": {
          "type": "string",
          "oneOf": [
            { "enum": ["Polygon"],    "description": "Polygon" },
            { "enum": ["Polyline"],   "description": "Polyline" },
            { "enum": ["Point"],      "description": "Point" },
            { "enum": ["Multipoint"], "description": "Multipoint" }
          ],
          "default": "Polygon"
        },
        
        "GeometryInputMode": {
          "type": "string",
          "oneOf": [
            { "enum": ["Manual"],    "description": "Manual" },
            { "enum": ["Automatic"],   "description": "Automatic" },
            { "enum": ["Semiautomatic"],      "description": "Semiautomatic" }
          ],
          "default": "Manual"
        },
        
        "GeometryOverlapDetection": { "type": "boolean", "default": false }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "Attachment": {
      "type": "object",
      "properties": {
        "Name": { "type": "string", "maxLength": 32 },
        "FileName": { "type": "string" },
        "ContentType": { "type": "string" }
      },
      "additionalProperties": false,
      "required": [ "Name", "FileName", "ContentType" ]
    },

    "AudioQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["AudioQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "Categories": {
      "type": "object",
      "properties": {
        "Name": { "type": "string", "maxLength": 32 },
        "FileName": { "type": "string" },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["FileName", "Name"]
    },

    "CriticalRule": {
      "type": "object",
      "properties": {
        "Message": { "type": "string" },
        "Expression": { "type": "string" },
        "Description": { "type": "string" },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["Message", "Expression"]
    },

    "DateTimeQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["DateTimeQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "IsTimestamp": { "type": "boolean", "default": false },
        "DefaultDate": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "FixedRosterTitle": {
      "type": "object",
      "properties": {
        "Value": { "type": "integer" },
        "Title": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["Value", "Title"]
    },

    "GpsCoordinateQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["GpsCoordinateQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },
    
    "CoverPage": {
      "type": "object",
      "properties": {
        "Type": {"enum": ["CoverPage"]},
        "Children": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/definitions/StaticText"},
              {"$ref": "#/definitions/DateTimeQuestion"},
              {"$ref": "#/definitions/GpsCoordinateQuestion"},
              {"$ref": "#/definitions/NumericQuestion"},
              {"$ref": "#/definitions/SingleQuestion"},
              {"$ref": "#/definitions/TextQuestion"},
              {"$ref": "#/definitions/Variable"}
            ]
          }
        },
        "Title": { "type": "string" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" }
      },

      "additionalProperties": false,
      "required": ["Type"]
    },

    "Group": {
      "type": "object",
      "properties": {
        "Type": {"enum": ["Group"]},
        "Children": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/definitions/Group"},
              {"$ref": "#/definitions/Roster"},
              {"$ref": "#/definitions/StaticText"},
              {"$ref": "#/definitions/AreaQuestion"},
              {"$ref": "#/definitions/AudioQuestion"},
              {"$ref": "#/definitions/DateTimeQuestion"},
              {"$ref": "#/definitions/GpsCoordinateQuestion"},
              {"$ref": "#/definitions/PictureQuestion"},
              {"$ref": "#/definitions/MultiOptionsQuestion"},
              {"$ref": "#/definitions/NumericQuestion"},
              {"$ref": "#/definitions/QRBarcodeQuestion"},
              {"$ref": "#/definitions/SingleQuestion"},
              {"$ref": "#/definitions/TextListQuestion"},
              {"$ref": "#/definitions/TextQuestion"},
              {"$ref": "#/definitions/Variable"}
            ]
          }
        },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Title": { "type": "string" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" }
      },

      "additionalProperties": false,
      "required": ["Type"]
    },

    "Roster": {
      "type": "object",
      "properties": {
        "Type": {"enum": ["Roster"]},
        "Children": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/definitions/Group"},
              {"$ref": "#/definitions/Roster"},
              {"$ref": "#/definitions/StaticText"},
              {"$ref": "#/definitions/AreaQuestion"},
              {"$ref": "#/definitions/AudioQuestion"},
              {"$ref": "#/definitions/DateTimeQuestion"},
              {"$ref": "#/definitions/GpsCoordinateQuestion"},
              {"$ref": "#/definitions/PictureQuestion"},
              {"$ref": "#/definitions/MultiOptionsQuestion"},
              {"$ref": "#/definitions/NumericQuestion"},
              {"$ref": "#/definitions/QRBarcodeQuestion"},
              {"$ref": "#/definitions/SingleQuestion"},
              {"$ref": "#/definitions/TextListQuestion"},
              {"$ref": "#/definitions/TextQuestion"},
              {"$ref": "#/definitions/Variable"}
            ]
          }
        },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Title": { "type": "string" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "DisplayMode": {
          "type": "string",
          "oneOf": [
            { "enum": ["SubSection"], "description": "Sub Section" },
            { "enum": ["Flat"], "description": "Flat" },
            { "enum": ["Table"], "description": "Table" },
            { "enum": ["Matrix"], "description": "Matrix" }
          ],
          "default": "SubSection"
        },
        "RosterSizeQuestion": { "$ref": "#/definitions/VariableName" },
        "RosterTitleQuestion": { "$ref": "#/definitions/VariableName" },
        "RosterSizeSource": {
          "type": "string",
          "oneOf": [
            { "enum": ["FixedTitles"], "description": "Fixed Titles" },
            { "enum": ["Question"], "description": "Question" }
          ],
          "default": "FixedTitles"
        },
        "FixedRosterTitles": {
          "type": [ "array", "null" ],
          "items": {
            "$ref": "#/definitions/FixedRosterTitle"
          }
        }
      },

      "additionalProperties": false,
      "required": ["Type"]
    },

    "GUID": { "type": "string", "format": "uuid" },

    "ValidationConditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ValidationCondition"
      },
      "maxItems": 10
    },

    "LookupTable": {
      "type": "object",
      "properties": {
        "TableName": {"type": "string", "maxLength": 32 },
        "FileName": {"type": "string"}
      },
      "additionalProperties": false,
      "required": ["TableName", "FileName"]
    },

    "Macro": {
      "type": "object",
      "properties": {
        "Name": { "type": "string", "maxLength": 32 },
        "Content": { "type": "string" },
        "Description": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["Name", "Content"]
    },

    "PictureQuestion": {
      "Type": "object",
      "properties": {
        "Type": { "enum": ["PictureQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "IsSignature": { "type": "boolean", "default": false }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "MultiOptionsQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["MultiOptionsQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "DisplayMode": {
          "type": "string",
          "oneOf": [
            { "enum": ["Checkboxes"], "description": "Checkboxes" },
            { "enum": ["YesNo"], "description": "Yes/No buttons" },
            { "enum": ["Combobox"], "description": "Combo box" }
          ],
          "default": "Checkboxes"
        },
        "AreAnswersOrdered": { "type": "boolean", "default": false },
        "MaxAllowedAnswers": { "type": "integer", "minimum": 2 },
        "CategoriesId": { "$ref": "#/definitions/GUID" },
        "Answers": { "$ref": "#/definitions/Answers" },
        "CascadeFromQuestion": { "$ref": "#/definitions/VariableName" },
        "FilterExpression": { "type": "string" },
        "LinkedTo": { "$ref": "#/definitions/VariableName" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "NumericQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["NumericQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "SpecialValues": { "$ref": "#/definitions/SpecialValues" },
        "DecimalPlaces": { "type": "integer", "minimum": 0 },
        "IsInteger": { "type": "boolean", "default": true },
        "IsNonNegative": { "type": "boolean", "default": false },
        "UseThousandsSeparator": { "type": "boolean", "default": false }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "QRBarcodeQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["QRBarcodeQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "QuestionScope": {
      "type": "string",
      "enum": [
        "Interviewer",
        "Supervisor",
        "Hidden"
      ],
      "default": "Interviewer"
    },

    "SingleQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["SingleQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "DisplayMode": {
          "type": "string",
          "oneOf": [
            { "enum": ["Radio"], "description": "Radio button list" },
            { "enum": ["Combobox"], "description": "Combo box" },
            { "enum": ["Cascading"], "description": "Cascading combo box" }
          ],
          "default": "Radio"
        },
        "ShowAsList": { "type": "boolean", "default": false },
        "ShowAsListThreshold": { "type": "integer" },
        "CategoriesId": { "$ref": "#/definitions/GUID" },
        "Answers": { "$ref": "#/definitions/Answers" },
        "CascadeFromQuestion": { "$ref": "#/definitions/VariableName" },
        "LinkedTo": { "$ref": "#/definitions/VariableName" },
        "FilterExpression": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "SpecialValue": {
      "type": "object",
      "properties": {
        "Text": { "type": "string" },
        "Code": { "type": "integer" },
        "AttachmentName": {"type": "string"}
      },
      "additionalProperties": false,
      "required": []
    },

    "SpecialValues": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SpecialValue"
      }
    },


    "StaticText": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["StaticText"] },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Text": { "type": "string" },
        "AttachmentName": { "type": "string" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Id": { "$ref": "#/definitions/GUID" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "TextListQuestion": {
      "type": "object",
      "properties": {
        "Type": {"enum": ["TextListQuestion"]},
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "MaxItemsCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "TextQuestion": {
      "type": "object",
      "properties": {
        "Type": { "enum": ["TextQuestion"] },
        "ConditionExpression": { "type": "string" },
        "HideIfDisabled": { "type": "boolean", "default": false },
        "Instructions": { "type": "string" },
        "HideInstructions": { "type": "boolean", "default": false },
        "IsCritical": { "type": "boolean", "default": false },
        "QuestionScope": { "$ref": "#/definitions/QuestionScope" },
        "QuestionText": { "type": "string" },
        "VariableLabel": { "$ref": "#/definitions/VariableLabel" },
        "ValidationConditions": { "$ref": "#/definitions/ValidationConditions" },
        "VariableName": { "$ref": "#/definitions/VariableName" },
        "Id": { "$ref": "#/definitions/GUID" },

        "Mask": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["Type"]
    },

    "Translations": {
      "type": "object",
      "properties": {
        "DefaultTranslation": { "$ref": "#/definitions/GUID" },
        "OriginalDisplayName": { "type": "string" },

        "Items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Translation"
          }
        }
      },
      "additionalProperties": false
    },
    
    "Translation": {
      "type": "object",
      "properties": {
        "Id": { "$ref": "#/definitions/GUID" },
        "Name": { "type": "string", "maxLength": 32 },
        "FileName": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["Name", "FileName"]
    },

    "ValidationCondition": {
      "type": "object",
      "properties": {
        "Expression": { "type": "string" },
        "Message": { "type": "string" },
        "Severity": {
          "type": "string",
          "oneOf": [
            { "enum": ["Error"], "description": "Error" },
            { "enum": ["Warning"], "description": "Warning" }
          ],
          "default": "Error"
        }
      },
      "additionalProperties": false,
      "required": ["Expression"]
    },

    "Variable": {
      "type": "object",
      "properties": {
        "Label": { "type": "string" },
        "VariableType": {
          "type": "string",
          "oneOf": [
            { "enum": ["LongInteger"], "description": "Long Integer" },
            { "enum": ["Double"], "description": "Double" },
            { "enum": ["Boolean"], "description": "Boolean" },
            { "enum": ["DateTime"], "description": "Date/Time" },
            { "enum": ["String"], "description": "String" }
          ],
          "default": "Boolean"
        },
        "Expression": { "type": "string" },
        "DoNotExport": { "type": "boolean", "default": false },
        "VariableName": { "$ref": "#/definitions/VariableName" }
      },
      "additionalOptions": false,
      "required": ["VariableName", "Expression"]
    },

    "VariableLabel": { "type": "string", "maxLength": 80 },

    "VariableName": { "type": "string", "maxLength": 32 },

    "QuestionnaireMetaInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SubTitle": { "type": [ "null", "string" ] },
        "StudyType": {
          "type": "string",
          "oneOf": [
            { "enum": ["AdministrativeRecords"], "description": "Administrative Records" },
            { "enum": ["AgriculturalCensus"], "description": "Agricultural Census" },
            { "enum": ["AgriculturalSurvey"], "description": "Agricu lturalSurvey" },
            { "enum": ["ChildLaborSurvey"], "description": "Child Labor Survey" },
            { "enum": ["CoreWelfareIndicatorsQuestionnaire"], "description": "Core Welfare Indicators Questionnaire" },
            { "enum": ["DemographicAndHealthSurvey"], "description": "Demographic And Health Survey" },
            { "enum": ["EnterpriseSurvey"], "description": "Enterprise Survey" },
            { "enum": ["EnterpriseCensus"], "description": "Enterprise Census" },
            { "enum": ["InformalSectorSurvey"], "description": "Informal Sector Survey" },
            { "enum": ["IntegratedSurvey"], "description": "Integrated Survey" },
            { "enum": ["MultipleIndicatorClusterSurvey"], "description": "Multiple Indicator Cluster Survey" },
