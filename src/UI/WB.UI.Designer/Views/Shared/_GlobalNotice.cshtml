@using WB.Core.BoundedContexts.Designer.Services
@using WB.UI.Designer.Resources
@inject IGlobalNoticeService GlobalNoticeService
@{
    var globalNotice = GlobalNoticeService.GetMessage();
}
@if (globalNotice != null)
{
    <style>
        .designer-global-notice {
            position: fixed;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1060;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            min-width: 300px;
            max-width: 40%;
            max-height: 30vh;
            padding: 8px 12px 8px 16px;
            background-color: #fff8d6;
            border: 1px solid #fad540;
            border-left: 4px solid #f0ad00;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            color: #333;
            font-size: 14px;
            font-weight: normal;
            line-height: 20px;
            letter-spacing: normal;
            text-align: left;
            text-transform: none;
        }

        .designer-global-notice-text {
            flex: 1;
            overflow-y: auto;
            overflow-wrap: anywhere;
            white-space: pre-line;
        }

        .designer-global-notice-close {
            flex: none;
            padding: 0;
            border: 0;
            background: none;
            color: #666;
            font-size: 20px;
            line-height: 20px;
            cursor: pointer;
        }

        .designer-global-notice-close:hover {
            color: #000;
        }
    </style>
    <div class="designer-global-notice" role="status">
        <span class="designer-global-notice-text">@globalNotice</span>
        <button type="button" class="designer-global-notice-close" aria-label="@QuestionnaireController.Close"
                onclick="this.parentElement.remove()"><span aria-hidden="true">&times;</span></button>
    </div>
}
