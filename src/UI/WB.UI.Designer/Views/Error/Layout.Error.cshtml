@using System.Globalization
@{
    var uiLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var uiDirection = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@uiLanguage" dir="@uiDirection">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(!string.IsNullOrEmpty(ViewBag.Title) ? ViewBag.Title : "Designer")</title>
    @Html.GenerateFavicon(Url.Content("~/favicon"))

   
    @RenderSection("Styles", required: false)


    @RenderSection("Scripts", required: false)

    <script type="text/javascript">
        function FrameCheck() {
            if (top != self)
                top.location.replace(self.location.href);
        }


/**/</script>
  <script type="module" crossorigin src="/js/errorLayout.js"></script>
  <link rel="modulepreload" crossorigin href="/js/modulepreload-polyfill.js">
  <link rel="modulepreload" crossorigin href="/js/jquery.min.js">
  <link rel="modulepreload" crossorigin href="/js/rejectionMessage.js">
  <link rel="modulepreload" crossorigin href="/js/jquery.validate.js">
  <link rel="modulepreload" crossorigin href="/js/validation.js">
  <link rel="modulepreload" crossorigin href="/js/logon2.js">
  <link rel="modulepreload" crossorigin href="/js/bootstrap.esm.js">
  <link rel="modulepreload" crossorigin href="/js/simplepage.js">
  <link rel="stylesheet" crossorigin href="/css/validation.css">
  <link rel="stylesheet" crossorigin href="/css/logon.css">
</head>
<body onload="FrameCheck();">
    <header>
        <a href="http://www.worldbank.org" class="logo"></a>
    </header>

    <section id="start-page">
        <div class="content-holder-outer">
            <div class="content-holder-inner">
                <div class="content-block">
                    <div class="form-holder">
                        <div class="form-row">
                            <div class="form-left">
                                <img src="~/i/designer-logo.png" />
                                <p>
                                    @AccountResources.AppDescription
                                </p>
                            </div>
                            <div class="form-splitter">
                                <div class="vline"></div>
                            </div>
                            <div class="form-right">
                                @RenderBody()
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <partial name="_commonFooter"/>
    </footer>
</body>
</html>
