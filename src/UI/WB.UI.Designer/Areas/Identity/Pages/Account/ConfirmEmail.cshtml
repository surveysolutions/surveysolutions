@page
@using WB.UI.Shared.Web.Extensions
@model ConfirmEmailModel

<form method="post" id="confirmEmailForm">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Code" />
    <h1></h1>
    <p class="note text-danger">
        @TempData[Alerts.ERROR]
    </p>
    <div class="form-actions">
        <a class="btn btn-success btn-lg" asp-page="./Login">@AccountResources.BackToLogin</a>
    </div>
</form>
@if (Model.AutoSubmit)
{
    <script>document.getElementById('confirmEmailForm').submit();</script>
}
