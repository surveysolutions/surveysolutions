<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Company>World Bank Group</Company>
    <WarningsAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8610;CS8613;CS8614;CS8618;CS8619;CS8620;CS8625;CS8629;CS8632;CS8634;CS8714</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- SixLabors.ImageSharp 1.0.4 remains only as a transitive dependency of PdfSharpCore/MigraDocCore.
       Image decoding is done by SkiaSharp (see SkiaImageSource), ImageSharp code is not called.
       Remove these suppressions together with PdfSharpCore. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2cmq-823j-5qj8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-63p8-c4ww-9cg7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-65x7-c272-7g7r" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5x7m-6737-26cr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g85r-6x2q-45w7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qxrv-gp6x-rc23" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxmq-m78w-7wmc" />
  </ItemGroup>
</Project>
